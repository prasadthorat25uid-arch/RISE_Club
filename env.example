# Required in production
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=RISE Office
ADMIN_PASSWORD=change-this-immediately

# PostgreSQL is recommended for production. SQLite works locally.
# DATABASE_URL=postgresql://user:password@host:5432/rise
DATABASE_URL=sqlite:///./rise.db

# Optional SMTP for invitation/reset/notification emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=RISE Club <noreply@example.com>
SMTP_TLS=true
PUBLIC_BASE_URL=http://localhost:8000

# Set true only behind HTTPS in production
COOKIE_SECURE=false
